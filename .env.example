# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/fleetpilot

# Long random string used to sign login sessions
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Administrator account created by the setup script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Business timezone for day and month boundaries
APP_TIMEZONE=Asia/Kolkata